# Copy this to .env and fill in real values. .env is gitignored - never
# commit it. See SETUP.md for how to load these into your shell.
#
# IMPORTANT: profiles.yml's three targets (sandbox/dev/validate) all read
# THE SAME env var names below. Switching --target does NOT switch which
# database you connect to - these env vars do. This has caused real
# confusion in this project before (pointing at the sandbox gateway IP
# while believing you were on real prod, or vice versa) - always confirm
# with `echo $CLAIMBOOK_HOST` before running anything, especially anything
# that writes.

# ---- Local sandbox (safe, disposable, full write access) ------------------
# Windows-hosted Postgres, reached from WSL2 via the gateway IP - NOT
# localhost, because WSL2 mirrored networking is off in this setup (find
# your own gateway IP with: cat /etc/resolv.conf | grep nameserver)
CLAIMBOOK_HOST=172.29.32.1
CLAIMBOOK_PORT=5433
CLAIMBOOK_USER=etl_user
CLAIMBOOK_PASSWORD=
CLAIMBOOK_DBNAME=claimbook_sandbox
CBREPORTS_DBNAME=cb_reports_sandbox

# ---- Real ClaimbookDB (READ-ONLY until write access is granted) -----------
# Uncomment and use these instead of the sandbox values above ONLY for
# read-only validation scripts (validation/*.py). Never for `dbt run`
# against a real target - see profiles.yml's comments on the `dev` target.
#
# CLAIMBOOK_HOST=4.213.181.70
# CLAIMBOOK_PORT=5433
# CLAIMBOOK_USER=claimbook_ranjithad
# CLAIMBOOK_PASSWORD=
# CLAIMBOOK_DBNAME=claimbook
# CBREPORTS_DBNAME=cb_reports
